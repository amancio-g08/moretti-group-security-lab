{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moretti Group admin, service and break-glass accounts",
  "type": "object",
  "required": ["admin_accounts", "service_accounts", "break_glass_accounts"],
  "additionalProperties": false,
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "justification": {"type": "string", "minLength": 20}
  },
  "properties": {
    "admin_accounts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["username", "owner", "privileged_roles", "justification"], "additionalProperties": false,
        "properties": {
          "username": {"type": "string", "pattern": "^adm-[a-z]+\\.[a-z]+$"},
          "owner": {"type": "string", "pattern": "^MG-[0-9]{4}$"},
          "privileged_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}},
          "justification": {"$ref": "#/$defs/justification"}
        }
      }
    },
    "service_accounts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["username", "purpose", "owner", "type", "interactive_logon", "entitlements", "justification"], "additionalProperties": false,
        "properties": {
          "username": {"type": "string", "pattern": "^svc-[a-z0-9-]+$"},
          "purpose": {"type": "string"},
          "owner": {"$ref": "#/$defs/slug"},
          "type": {"enum": ["gmsa", "standard"]},
          "interactive_logon": {"const": false},
          "entitlements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "justification": {"$ref": "#/$defs/justification"}
        }
      }
    },
    "break_glass_accounts": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "required": ["username", "owner", "privileged_roles", "justification"], "additionalProperties": false,
        "properties": {
          "username": {"type": "string", "pattern": "^bg-[a-z0-9]+$"},
          "owner": {"$ref": "#/$defs/slug"},
          "privileged_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}},
          "justification": {"$ref": "#/$defs/justification"}
        }
      }
    }
  }
}
