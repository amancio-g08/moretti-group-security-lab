{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moretti Group network communication matrix",
  "type": "object",
  "required": ["version", "default_action", "segments", "segment_groups", "services", "rules"],
  "additionalProperties": false,
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "envs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pt", "aws"]}},
    "ref": {"type": "string", "pattern": "^(internet|seg:[a-z0-9-]+|grp:[a-z0-9-]+|asset:[A-Z0-9]+(-[A-Z0-9]+)*)$"},
    "port": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 65535},
        {"type": "string", "pattern": "^[0-9]{1,5}-[0-9]{1,5}$"},
        {"const": "any"}
      ]
    }
  },
  "properties": {
    "version": {"type": "integer"},
    "default_action": {"const": "deny"},
    "segments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "vlan", "cidr", "trust", "description", "environments"], "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "name": {"type": "string", "pattern": "^[A-Z-]+$"},
          "vlan": {"type": ["integer", "null"], "minimum": 2, "maximum": 4094},
          "cidr": {"type": ["string", "null"], "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"},
          "trust": {"enum": ["management", "user-restricted", "user", "security", "server", "untrusted", "dmz", "infrastructure", "none"]},
          "description": {"type": "string"},
          "environments": {"$ref": "#/$defs/envs"}
        }
      }
    },
    "segment_groups": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "segments"], "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "description": {"type": "string"},
          "segments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
        }
      }
    },
    "services": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "description", "ports"], "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "description": {"type": "string"},
          "notes": {"type": "string"},
          "ports": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["proto", "port"], "additionalProperties": false,
              "properties": {"proto": {"enum": ["tcp", "udp", "icmp", "any"]}, "port": {"$ref": "#/$defs/port"}}
            }
          }
        }
      }
    },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "source", "destination", "service", "action", "applies_to", "justification"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^NM-[0-9]{3}$"},
          "source": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
          "destination": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
          "service": {"$ref": "#/$defs/slug"},
          "action": {"enum": ["allow", "deny"]},
          "log": {"type": "boolean"},
          "applies_to": {"$ref": "#/$defs/envs"},
          "justification": {"type": "string", "minLength": 20}
        },
        "if": {"properties": {"action": {"const": "deny"}}},
        "then": {"required": ["log"]}
      }
    }
  }
}
