{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moretti Group asset inventory",
  "type": "object",
  "required": ["assets"],
  "additionalProperties": false,
  "properties": {
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "role", "os", "segment", "ip", "owner", "criticality", "classification", "environments"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"},
          "type": {"enum": ["server", "workstation", "network"]},
          "role": {"type": "string"},
          "os": {"type": "string"},
          "segment": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "ip": {"type": "string", "format": "ipv4"},
          "owner": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "criticality": {"enum": ["critical", "high", "medium", "low"]},
          "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
          "environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pt", "aws"]}},
          "aws_phase": {"type": "integer", "minimum": 4, "maximum": 9},
          "notes": {"type": "string"}
        },
        "if": {"properties": {"environments": {"contains": {"const": "aws"}}}},
        "then": {"required": ["aws_phase"]}
      }
    }
  }
}
