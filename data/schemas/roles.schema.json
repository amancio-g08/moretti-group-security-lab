{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moretti Group roles and entitlements",
  "type": "object",
  "required": ["entitlements", "baseline_entitlements", "roles", "privileged_roles"],
  "additionalProperties": false,
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "review": {"enum": ["monthly", "quarterly", "semiannual", "annual"]}
  },
  "properties": {
    "entitlements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "system", "access", "ad_group", "owner", "classification"], "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "system": {"type": "string"},
          "access": {"type": "string"},
          "ad_group": {"type": "string", "pattern": "^(DL-[A-Za-z0-9-]+|Domain Admins)$"},
          "owner": {"$ref": "#/$defs/slug"},
          "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
          "privileged": {"type": "boolean"}
        }
      }
    },
    "baseline_entitlements": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
    "roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "ad_group", "departments", "entitlements", "review", "justification"], "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "ad_group": {"type": "string", "pattern": "^GG-Role-[A-Za-z]+$"},
          "departments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}},
          "entitlements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
          "review": {"$ref": "#/$defs/review"},
          "justification": {"type": "string", "minLength": 20}
        }
      }
    },
    "privileged_roles": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "tier", "entitlements", "review", "justification"], "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "tier": {"enum": [0, 1, 2]},
          "entitlements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}},
          "review": {"$ref": "#/$defs/review"},
          "justification": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
