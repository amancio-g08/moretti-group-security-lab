# ---------------------------------------------------------------------
# Moretti Group Security Lab — local environment template
#
# Copy to .env (which is git-ignored) and adjust values:
#     cp .env.example .env
#
# RULES
#   - This file holds NON-SECRET configuration only.
#   - Lab passwords are never stored here. They are generated at deploy
#     time and kept in AWS SSM Parameter Store (SecureString).
#   - Use a named AWS CLI profile backed by IAM Identity Center (SSO).
#     Never put long-lived access keys in this file.
# ---------------------------------------------------------------------

# --- AWS --------------------------------------------------------------
AWS_PROFILE=moretti-lab
AWS_REGION=us-east-1

# --- Lab identity / tagging -------------------------------------------
LAB_NAME=moretti-lab
LAB_OWNER=your-github-handle

# --- Cost guardrails (see ADR-004, ADR-007) ---------------------------
BUDGET_LIMIT_USD=30
BUDGET_ALERT_EMAIL=you@example.com

# --- Terraform toggles (consumed as TF_VAR_*) -------------------------
# Egress is off by default and enabled only for phases that need it.
TF_VAR_enable_egress=false

# --- Entra ID (Phase 8) -----------------------------------------------
# Tenant domain only; no client secrets here.
ENTRA_TENANT_DOMAIN=example.onmicrosoft.com

# --- Local port forwarding via SSM (Phase 4+) --------------------------
WAZUH_DASHBOARD_LOCAL_PORT=8443
RDP_LOCAL_PORT=13389
